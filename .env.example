# AtlasFix ML Service — variables d'environnement
# Copie ce fichier en .env et remplis tes valeurs

# ── Environnement ──────────────────────────────────────────────────────────────
ENV=development          # development | production

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_ALLOW_FILE_STORE=true
MLFLOW_TRACKING_URI=./mlflow_store

# ── LLM optionnel (chatbot avancé) ────────────────────────────────────────────
# Laisse vide pour utiliser le chatbot par mots-clés (gratuit)
# Remplis pour activer GPT-4o-mini
OPENAI_API_KEY=

# ── Laravel (pour les appels internes) ────────────────────────────────────────
LARAVEL_URL=http://localhost:8000
